[Unit]
Description=Movie Recommendation Bot Service
After=network.target postgresql.service

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/moviebot
EnvironmentFile=/opt/moviebot/.env
ExecStart=/usr/bin/java -Djava.net.preferIPv4Stack=true -jar /opt/moviebot/MovieRecommendationBot.jar
Restart=always
RestartSec=10
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=moviebot

[Install]
WantedBy=multi-user.target